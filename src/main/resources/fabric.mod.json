{
	"schemaVersion": 1,
	"id": "locatorfinder",
	"version": "${version}",
	"name": "Locator Finder",
	"description": "Works out player coordinates from the data the server sends for the locator bar.",
	"authors": ["Akshay"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["locatorfinder.LocatorFinderClient"]
	},
	"mixins": [
		{ "config": "locatorfinder.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.20.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
